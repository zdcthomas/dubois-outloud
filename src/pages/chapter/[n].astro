---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Epigraph from '../../components/Epigraph.astro';
import RecordingList from '../../components/RecordingList.astro';

export async function getStaticPaths() {
  // Declared inside getStaticPaths, not in module scope: Astro hoists this
  // function and evaluates it on its own, so a module-scope const is simply
  // not defined by the time it runs.
  //
  // Eager, so the template receives ImageMetadata directly rather than a
  // loader it would have to await inside a .map(), which Astro disallows.
  // src/assets/notation is a build artifact, so this is {} until
  // `pnpm fetch:scans` has run; a song with no cropped staff shows none.
  const notation = import.meta.glob<{ default: ImageMetadata }>(
    '../../assets/notation/*.png',
    { eager: true },
  );

  const chapters = await getCollection('chapters', (c) => c.data.chapter !== null);
  const songs = await getCollection('songs');
  const approved = await getCollection('recordings', (r) => r.data.status === 'approved');

  return chapters.map((entry) => ({
    params: { n: String(entry.data.chapter) },
    props: {
      entry,
      songs: songs
        .filter((s) => s.data.chapter === entry.data.chapter)
        .map((s) => ({
          title: s.data.title,
          scan: s.data.scan,
          notation:
            notation[`../../assets/notation/${s.data.slug}.png`]?.default ?? null,
          // The manifest gate guarantees an approved entry has a non-null
          // audio_url and a delivery, so narrowing here is safe and keeps the
          // component's props honest about never receiving a null source.
          recordings: approved
            .filter((r) => r.data.song === s.data.slug)
            .map((r) => r.data as typeof r.data & {
              delivery: 'selfhost' | 'stream';
              loc: NonNullable<typeof r.data.loc> & { audio_url: string };
            }),
        })),
    },
  }));
}

const { entry, songs } = Astro.props;
const { Content } = await render(entry);
const n = entry.data.chapter!;
---
<Base title={`${n}. ${entry.data.heading} — The Souls of Black Folk`}>
  <p class="eyebrow">Chapter {n}</p>
  <h1>{entry.data.heading}</h1>

  {songs.map((song) => (
    <>
      <Epigraph
        songTitle={song.title}
        notation={song.notation}
        iaItem={song.scan?.ia_item ?? null}
        page={song.scan?.page ?? null}
      />
      <RecordingList recordings={song.recordings} songTitle={song.title} />
    </>
  ))}

  <article><Content /></article>

  <nav class="chapter-nav">
    {n > 1 && <a href={`/chapter/${n - 1}/`} rel="prev">Previous chapter</a>}
    {n < 14 && <a href={`/chapter/${n + 1}/`} rel="next">Next chapter</a>}
    {n === 14 && <a href="/afterthought/" rel="next">The Afterthought</a>}
  </nav>

  <script>
    import '../../components/audio-exclusive.ts';
  </script>

  <style>
    .eyebrow { text-transform: uppercase; letter-spacing: .08em; font-size: .8rem; }
    .chapter-nav { display: flex; justify-content: space-between; margin-top: 3rem; }
  </style>
</Base>
