---
import { Image } from 'astro:assets';
import type { Song } from '../schemas.ts';

interface Props {
  songTitle: string;
  notation: ImageMetadata | null;
  scan: Song['scan'];
}

const { songTitle, notation, scan } = Astro.props;

// Two shapes of `scan`, two places the staff came from, so the caption credits
// whichever one this chapter actually used. See src/data/songs.yaml.
const source =
  scan === null
    ? null
    : 'plate' in scan
      ? { href: 'https://way.net/SoulsOfBlackFolk/', label: 'the musical hypertext edition at way.net' }
      : {
          href: `https://archive.org/details/${scan.ia_item}/page/n${scan.page}`,
          label: 'the page scan at the Internet Archive',
        };
---
{notation && (
  <figure class="epigraph">
    <Image
      src={notation}
      alt={`A bar of musical notation for the spiritual "${songTitle}", printed without words at the head of this chapter in the 1903 edition.`}
    />
    <figcaption>
      <cite>{songTitle}</cite>, as Du Bois printed it — the melody alone, with
      no words.
      {source && (
        <>
          {' '}From the 1903 first edition, by way of
          {' '}<a href={source.href}>{source.label}</a>.
        </>
      )}
    </figcaption>
    <style>
      .epigraph { margin: 2rem 0; }
      /* max-width, not width: a way.net plate is only ~440px wide, and
         stretching it to the column would just blur it. Centred because most
         of them are narrower than the text. */
      .epigraph img { display: block; margin: 0 auto; max-width: 100%; height: auto; }
      .epigraph figcaption { font-size: .85rem; opacity: .85; margin-top: .5rem; }
      /* The scan is black on white; invert it so it reads in a dark theme. */
      @media (prefers-color-scheme: dark) {
        .epigraph img { filter: invert(1); }
      }
    </style>
  </figure>
)}
